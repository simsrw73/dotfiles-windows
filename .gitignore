# --- chezmoi source repo ---
# secrets written at apply time into linked dirs; never commit
linked/FlowLauncher/Settings/Plugins/Github Quick Launcher/

# plan execution scratch
.superpowers/

# yasb: runtime logs and files it generates
linked/yasb/*.log
linked/yasb/*.log.*
linked/yasb/yasb_colors.css

# claude: keep config only (settings, hooks, skills, plugin manifests, memory)
linked/claude/*
!linked/claude/settings.json
!linked/claude/hooks/
!linked/claude/skills/
linked/claude/skills/synced/
!linked/claude/plugins/
linked/claude/plugins/*
!linked/claude/plugins/installed_plugins.json
!linked/claude/plugins/known_marketplaces.json
!linked/claude/projects/
linked/claude/projects/*/*
!linked/claude/projects/*/memory/

# secrets / machine state (not managed; live only in ~/.config)
home/dot_config/gnupg/
home/dot_config/github-copilot/
home/dot_config/docker/
home/dot_config/gh/hosts.yml

# runtime noise
home/dot_config/joplin-desktop/log*.txt
home/dot_config/joplin-desktop/cache/
home/dot_config/joplin-desktop/tmp/
home/dot_config/hyper/.hyper_plugins/
linked/FlowLauncher/Cache/
linked/FlowLauncher/Logs/
linked/FlowLauncher/Plugins/
linked/FlowLauncher/Settings/**/*.bak
linked/FlowLauncher/Settings/**/*.tmp
linked/FlowLauncher/Settings/History.json
linked/FlowLauncher/Settings/Plugins/**/*.bak

# AutoHotKey: agent/tool scratch dirs
linked/AutoHotKey/.git/
linked/AutoHotKey/.agents/
linked/AutoHotKey/.codex/
linked/AutoHotKey/.superpowers/

# komorebi: example bar config regenerated by `komorebic start` (yasb is the bar)
linked/komorebi/komorebi.bar.json
