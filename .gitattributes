# Flow Launcher rewrites runtime state into its settings; lib/flow-state.sed
# pins those values in the repo copy (the live file keeps the real ones).
# The filter is registered by bootstrap.ps1:
#   git config filter.flowstate.clean "sed -E -f lib/flow-state.sed"
linked/FlowLauncher/Settings/Settings.json filter=flowstate
linked/FlowLauncher/Settings/Plugins/Flow.Launcher.Plugin.Program/Settings.json filter=flowstate
