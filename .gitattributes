# Everything is stored and checked out with LF, whatever core.autocrlf says
# (Git for Windows sets it to true system-wide, which expects CRLF on disk
# and flags LF files written by editors and apps as modified).
* text=auto eol=lf

# live copies have mixed line endings: store bytes exactly
home/dot_config/carapace/specs/*.yaml -text
home/dot_config/delta/catppuccin.gitconfig -text
home/dot_config/git/config -text
