{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NonInteractive -File .claude/hooks/lint-ps1.ps1",
            "timeout": 30,
            "statusMessage": "PSScriptAnalyzer..."
          }
        ]
      }
    ]
  }
}
