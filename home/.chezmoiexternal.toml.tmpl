["projects/DotForge"]
    type = "git-repo"
    url = "https://github.com/simsrw73/DotForge.git"
    refreshPeriod = "168h"

# Starship prompt config: the p9cat preset, maintained in its own public repo.
[".config/starship.toml"]
    type = "file"
    url = "https://raw.githubusercontent.com/simsrw73/starship-p9cat/main/p9cat.toml"
    refreshPeriod = "168h"

# PowerShell transient prompt for the same preset; dot-sourced by profile.ps1.
[".config/starship/p9cat.transient.ps1"]
    type = "file"
    url = "https://raw.githubusercontent.com/simsrw73/starship-p9cat/main/p9cat.transient.ps1"
    refreshPeriod = "168h"
